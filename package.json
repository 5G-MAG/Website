{
  "name": "5g-mag-portal",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "build-news-data": "node scripts/build-news-data.js",
    "build-ai-registry": "node scripts/build-ai-registry.js",
    "build-content-index": "node scripts/build-content-index.js",
    "build-events-data": "node scripts/build-events-data.js",
    "fetch-repo-metadata": "node scripts/fetch-repo-metadata.js",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "fetch-youtube": "node scripts/fetch-youtube-playlists.js",
    "taxonomy-admin": "node scripts/taxonomy-admin.js",
    "validate-frontmatter": "node scripts/validate-frontmatter.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "npm run validate-frontmatter && npm run build-news-data && npm run build-events-data && npm run build-ai-registry && npm run build-content-index",
    "prestart": "npm run build-news-data && npm run build-events-data && npm run build-ai-registry && npm run build-content-index",
    "postinstall": "patch-package",
    "report:specs": "node scripts/report-spec-versions.js"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@docusaurus/theme-search-algolia": "^3.10.2",
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
